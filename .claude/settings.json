{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(pytest *)",
      "Bash(PYTHONPATH=. pytest *)",
      "Bash(python -m *)",
      "Bash(python3 -m *)",
      "Bash(PYTHONPATH=. python *)",
      "Bash(pip install *)",
      "Bash(uv *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(docker compose *)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl http://localhost*)",
      "Bash(ls *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(aws *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Bash(cat .env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(rm -rf *)"
    ]
  }
}
