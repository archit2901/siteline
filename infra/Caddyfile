# Siteline on one EC2 box: the web build at /, agent-api at /api (same origin, so no CORS).
# SITE_ADDRESS is a hostname for automatic HTTPS (e.g. 203-0-113-7.sslip.io for an Elastic IP), or :80 for HTTP only.
# The whole site is behind a password: live runs spend Bedrock credits and results show licensed CoStar spaces.
# SITE_USER and SITE_PASSWORD_HASH (from `caddy hash-password`) come from .env.caddy; without them every request gets 401.
{$SITE_ADDRESS::80} {
	basic_auth {
		{$SITE_USER} {$SITE_PASSWORD_HASH}
	}

	handle_path /api/* {
		reverse_proxy agent:8000 {
			# Server-sent events: send each event as soon as it is written
			flush_interval -1
		}
	}

	handle {
		encode gzip
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
