{
  "$defs": {
    "Claim": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CommunityNeed": {
      "description": "Who lives in a site's catchment, from Census data (Python-computed, population-weighted).",
      "properties": {
        "minutes": {
          "title": "Minutes",
          "type": "number"
        },
        "households": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Households"
        },
        "no_car_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Car Share"
        },
        "renter_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renter Share"
        },
        "medicaid_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medicaid Share"
        },
        "lower_income_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Income Share"
        }
      },
      "required": [
        "minutes"
      ],
      "title": "CommunityNeed",
      "type": "object"
    },
    "SiteCandidate": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "h3": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H3"
        },
        "submarket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submarket"
        },
        "sqft": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqft"
        },
        "rent_psf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rent Psf"
        },
        "floor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor"
        },
        "building_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Class"
        },
        "available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available"
        },
        "parking_spaces": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parking Spaces"
        },
        "parking_estimated": {
          "default": false,
          "title": "Parking Estimated",
          "type": "boolean"
        },
        "matterport_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matterport Id"
        },
        "vexcel_image_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vexcel Image Ref"
        },
        "source": {
          "default": "costar",
          "enum": [
            "costar",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "checks": {
          "additionalProperties": true,
          "title": "Checks",
          "type": "object"
        }
      },
      "required": [
        "id",
        "address",
        "lat",
        "lon"
      ],
      "title": "SiteCandidate",
      "type": "object"
    },
    "SiteInspection": {
      "description": "What the site-inspector checked for one space, combining CoStar (listing), Vexcel (aerial) and Matterport (3D).\nEvery number comes from those APIs or the listing; findings are rendered by Python from these values.",
      "properties": {
        "checked": {
          "items": {
            "type": "string"
          },
          "title": "Checked",
          "type": "array"
        },
        "parked_cars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parked Cars"
        },
        "radius_m": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius M"
        },
        "listed_parking": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listed Parking"
        },
        "occupancy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupancy"
        },
        "scan_area_sqft": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Area Sqft"
        },
        "scan_rooms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Rooms"
        },
        "scan_floors": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Floors"
        },
        "scan_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Name"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "unavailable": {
          "items": {
            "type": "string"
          },
          "title": "Unavailable",
          "type": "array"
        }
      },
      "title": "SiteInspection",
      "type": "object"
    }
  },
  "properties": {
    "rank": {
      "title": "Rank",
      "type": "integer"
    },
    "site": {
      "$ref": "#/$defs/SiteCandidate"
    },
    "net_new_patients": {
      "title": "Net New Patients",
      "type": "number"
    },
    "zone_score": {
      "title": "Zone Score",
      "type": "number"
    },
    "site_quality": {
      "title": "Site Quality",
      "type": "number"
    },
    "final_score": {
      "title": "Final Score",
      "type": "number"
    },
    "stability": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stability"
    },
    "justification": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Justification",
      "type": "array"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "annual_rent_per_customer": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annual Rent Per Customer"
    },
    "inspection": {
      "anyOf": [
        {
          "$ref": "#/$defs/SiteInspection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "community": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommunityNeed"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "rank",
    "site",
    "net_new_patients",
    "zone_score",
    "site_quality",
    "final_score",
    "justification"
  ],
  "title": "Recommendation",
  "type": "object"
}