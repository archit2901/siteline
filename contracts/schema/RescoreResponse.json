{
  "$defs": {
    "Claim": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Recommendation": {
      "properties": {
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "site": {
          "$ref": "#/$defs/SiteCandidate"
        },
        "net_new_patients": {
          "title": "Net New Patients",
          "type": "number"
        },
        "zone_score": {
          "title": "Zone Score",
          "type": "number"
        },
        "site_quality": {
          "title": "Site Quality",
          "type": "number"
        },
        "final_score": {
          "title": "Final Score",
          "type": "number"
        },
        "stability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stability"
        },
        "justification": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Justification",
          "type": "array"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        }
      },
      "required": [
        "rank",
        "site",
        "net_new_patients",
        "zone_score",
        "site_quality",
        "final_score",
        "justification"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "ScoreResponse": {
      "properties": {
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/ZoneScore"
          },
          "title": "Zones",
          "type": "array"
        },
        "top": {
          "items": {
            "type": "string"
          },
          "title": "Top",
          "type": "array"
        }
      },
      "required": [
        "region_id",
        "zones",
        "top"
      ],
      "title": "ScoreResponse",
      "type": "object"
    },
    "SiteCandidate": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "h3": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H3"
        },
        "submarket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submarket"
        },
        "sqft": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqft"
        },
        "rent_psf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rent Psf"
        },
        "floor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor"
        },
        "building_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Class"
        },
        "available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available"
        },
        "parking_spaces": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parking Spaces"
        },
        "parking_estimated": {
          "default": false,
          "title": "Parking Estimated",
          "type": "boolean"
        },
        "matterport_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matterport Id"
        },
        "vexcel_image_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vexcel Image Ref"
        },
        "source": {
          "default": "costar",
          "enum": [
            "costar",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "checks": {
          "additionalProperties": true,
          "title": "Checks",
          "type": "object"
        }
      },
      "required": [
        "id",
        "address",
        "lat",
        "lon"
      ],
      "title": "SiteCandidate",
      "type": "object"
    },
    "ZoneScore": {
      "properties": {
        "h3": {
          "title": "H3",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "demand": {
          "title": "Demand",
          "type": "number"
        },
        "contributions": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Contributions",
          "type": "object"
        }
      },
      "required": [
        "h3",
        "score",
        "demand"
      ],
      "title": "ZoneScore",
      "type": "object"
    }
  },
  "properties": {
    "zones": {
      "$ref": "#/$defs/ScoreResponse"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    }
  },
  "required": [
    "zones",
    "recommendations"
  ],
  "title": "RescoreResponse",
  "type": "object"
}