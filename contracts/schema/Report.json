{
  "$defs": {
    "Claim": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CommunityNeed": {
      "description": "Who lives in a site's catchment, from Census data (Python-computed, population-weighted).",
      "properties": {
        "minutes": {
          "title": "Minutes",
          "type": "number"
        },
        "households": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Households"
        },
        "no_car_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Car Share"
        },
        "renter_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renter Share"
        },
        "medicaid_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medicaid Share"
        },
        "lower_income_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Income Share"
        }
      },
      "required": [
        "minutes"
      ],
      "title": "CommunityNeed",
      "type": "object"
    },
    "Constraints": {
      "properties": {
        "min_sqft": {
          "default": 2000,
          "title": "Min Sqft",
          "type": "integer"
        },
        "max_sqft": {
          "default": 8000,
          "title": "Max Sqft",
          "type": "integer"
        },
        "max_rent_psf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rent Psf"
        },
        "min_parking_per_1000sf": {
          "default": 4.0,
          "title": "Min Parking Per 1000Sf",
          "type": "number"
        },
        "ground_floor": {
          "default": true,
          "title": "Ground Floor",
          "type": "boolean"
        },
        "special_rooms": {
          "items": {
            "type": "string"
          },
          "title": "Special Rooms",
          "type": "array"
        },
        "space_uses": {
          "items": {
            "type": "string"
          },
          "title": "Space Uses",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "DemandModel": {
      "description": "Who the customers are, who competes and what space fits: written by the business profiler, validated in\nPython against the grid. Healthcare presets derive it from their pack.",
      "properties": {
        "segments": {
          "items": {
            "$ref": "#/$defs/DemandSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "demand_label": {
          "default": "customers",
          "title": "Demand Label",
          "type": "string"
        },
        "competitor_feature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competitor Feature"
        },
        "competitor_label": {
          "default": "",
          "title": "Competitor Label",
          "type": "string"
        },
        "space_uses": {
          "items": {
            "type": "string"
          },
          "title": "Space Uses",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "trip": {
          "default": "destination",
          "enum": [
            "neighborhood",
            "local",
            "destination"
          ],
          "title": "Trip",
          "type": "string"
        }
      },
      "title": "DemandModel",
      "type": "object"
    },
    "DemandSegment": {
      "description": "One group of people who are this business's customers, measured by a grid feature.",
      "properties": {
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "feature_id",
        "label"
      ],
      "title": "DemandSegment",
      "type": "object"
    },
    "Factor": {
      "description": "Written by the factor-analyst. One thing that makes a new office succeed for this practice.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "factor": {
          "title": "Factor",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "proxy": {
          "title": "Proxy",
          "type": "string"
        },
        "direction": {
          "enum": [
            1,
            -1
          ],
          "title": "Direction",
          "type": "integer"
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "stock_covered": {
          "default": false,
          "title": "Stock Covered",
          "type": "boolean"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "status": {
          "default": "searching",
          "enum": [
            "covered",
            "searching",
            "found",
            "proxy",
            "dropped"
          ],
          "title": "Status",
          "type": "string"
        },
        "caveat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caveat"
        }
      },
      "required": [
        "id",
        "factor",
        "why",
        "proxy",
        "direction",
        "priority"
      ],
      "title": "Factor",
      "type": "object"
    },
    "Office": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "clinicians": {
          "default": 1,
          "title": "Clinicians",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "Office",
      "type": "object"
    },
    "PracticeProfile": {
      "description": "Intake for any business (the name is historical). Healthcare fills specialty/payers; others business_type.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "specialty": {
          "default": "",
          "title": "Specialty",
          "type": "string"
        },
        "business_type": {
          "default": "",
          "title": "Business Type",
          "type": "string"
        },
        "customers": {
          "default": "",
          "title": "Customers",
          "type": "string"
        },
        "services": {
          "items": {
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        },
        "payers_accepted": {
          "items": {
            "type": "string"
          },
          "title": "Payers Accepted",
          "type": "array"
        },
        "patient_mix": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Patient Mix",
          "type": "object"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "existing_offices": {
          "items": {
            "$ref": "#/$defs/Office"
          },
          "title": "Existing Offices",
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "free_text": {
          "default": "",
          "title": "Free Text",
          "type": "string"
        },
        "stock_pack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stock Pack"
        },
        "region_id": {
          "default": "hou",
          "title": "Region Id",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "PracticeProfile",
      "type": "object"
    },
    "Recommendation": {
      "properties": {
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "site": {
          "$ref": "#/$defs/SiteCandidate"
        },
        "net_new_patients": {
          "title": "Net New Patients",
          "type": "number"
        },
        "zone_score": {
          "title": "Zone Score",
          "type": "number"
        },
        "site_quality": {
          "title": "Site Quality",
          "type": "number"
        },
        "final_score": {
          "title": "Final Score",
          "type": "number"
        },
        "stability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stability"
        },
        "justification": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Justification",
          "type": "array"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "annual_rent_per_customer": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annual Rent Per Customer"
        },
        "inspection": {
          "anyOf": [
            {
              "$ref": "#/$defs/SiteInspection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "community": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommunityNeed"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rank",
        "site",
        "net_new_patients",
        "zone_score",
        "site_quality",
        "final_score",
        "justification"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "SiteCandidate": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "h3": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H3"
        },
        "submarket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submarket"
        },
        "sqft": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqft"
        },
        "rent_psf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rent Psf"
        },
        "floor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor"
        },
        "building_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Class"
        },
        "available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available"
        },
        "parking_spaces": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parking Spaces"
        },
        "parking_estimated": {
          "default": false,
          "title": "Parking Estimated",
          "type": "boolean"
        },
        "matterport_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matterport Id"
        },
        "vexcel_image_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vexcel Image Ref"
        },
        "source": {
          "default": "costar",
          "enum": [
            "costar",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "checks": {
          "additionalProperties": true,
          "title": "Checks",
          "type": "object"
        }
      },
      "required": [
        "id",
        "address",
        "lat",
        "lon"
      ],
      "title": "SiteCandidate",
      "type": "object"
    },
    "SiteInspection": {
      "description": "What the site-inspector checked for one space, combining CoStar (listing), Vexcel (aerial) and Matterport (3D).\nEvery number comes from those APIs or the listing; findings are rendered by Python from these values.",
      "properties": {
        "checked": {
          "items": {
            "type": "string"
          },
          "title": "Checked",
          "type": "array"
        },
        "parked_cars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parked Cars"
        },
        "radius_m": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius M"
        },
        "listed_parking": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listed Parking"
        },
        "occupancy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupancy"
        },
        "scan_area_sqft": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Area Sqft"
        },
        "scan_rooms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Rooms"
        },
        "scan_floors": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Floors"
        },
        "scan_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Name"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "unavailable": {
          "items": {
            "type": "string"
          },
          "title": "Unavailable",
          "type": "array"
        }
      },
      "title": "SiteInspection",
      "type": "object"
    }
  },
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/PracticeProfile"
    },
    "factors": {
      "items": {
        "$ref": "#/$defs/Factor"
      },
      "title": "Factors",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "sources": {
      "additionalProperties": {
        "format": "uri",
        "maxLength": 2083,
        "minLength": 1,
        "type": "string"
      },
      "title": "Sources",
      "type": "object"
    },
    "verified": {
      "default": false,
      "title": "Verified",
      "type": "boolean"
    },
    "demand_label": {
      "default": "patients",
      "title": "Demand Label",
      "type": "string"
    },
    "demand": {
      "anyOf": [
        {
          "$ref": "#/$defs/DemandModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "profile",
    "factors",
    "recommendations"
  ],
  "title": "Report",
  "type": "object"
}