  "properties": {
    "region_id": {
      "default": "hou",
      "title": "Region Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/PracticeProfile"
    },
    "spec": {
      "$ref": "#/$defs/ScoringSpec"
