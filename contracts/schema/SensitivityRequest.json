        },
        "parking_estimated": {
          "default": false,
          "title": "Parking Estimated",
          "type": "boolean"
        },
        "matterport_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matterport Id"
        },
        "vexcel_image_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vexcel Image Ref"
        },
        "source": {
          "default": "costar",
          "enum": [
            "costar",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "checks": {
          "additionalProperties": true,
          "title": "Checks",
          "type": "object"
        }
      },
      "required": [
        "id",
        "address",
        "lat",
        "lon"
      ],
      "title": "SiteCandidate",
      "type": "object"
    }
