{
  "$defs": {
    "Constraints": {
      "properties": {
        "min_sqft": {
          "default": 2000,
          "title": "Min Sqft",
          "type": "integer"
        },
        "max_sqft": {
          "default": 8000,
          "title": "Max Sqft",
          "type": "integer"
        },
        "max_rent_psf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rent Psf"
        },
        "min_parking_per_1000sf": {
          "default": 4.0,
          "title": "Min Parking Per 1000Sf",
          "type": "number"
        },
        "ground_floor": {
          "default": true,
          "title": "Ground Floor",
          "type": "boolean"
        },
        "special_rooms": {
          "items": {
            "type": "string"
          },
          "title": "Special Rooms",
          "type": "array"
        },
        "space_uses": {
          "items": {
            "type": "string"
          },
          "title": "Space Uses",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "DemandModel": {
      "description": "Who the customers are, who competes and what space fits: written by the business profiler, validated in\nPython against the grid. Healthcare presets derive it from their pack.",
      "properties": {
        "segments": {
          "items": {
            "$ref": "#/$defs/DemandSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "demand_label": {
          "default": "customers",
          "title": "Demand Label",
          "type": "string"
        },
        "competitor_feature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competitor Feature"
        },
        "competitor_label": {
          "default": "",
          "title": "Competitor Label",
          "type": "string"
        },
        "space_uses": {
          "items": {
            "type": "string"
          },
          "title": "Space Uses",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        }
      },
      "title": "DemandModel",
      "type": "object"
    },
    "DemandSegment": {
      "description": "One group of people who are this business's customers, measured by a grid feature.",
      "properties": {
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "feature_id",
        "label"
      ],
      "title": "DemandSegment",
      "type": "object"
    },
    "Office": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "clinicians": {
          "default": 1,
          "title": "Clinicians",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "Office",
      "type": "object"
    },
    "PracticeProfile": {
      "description": "Intake for any business (the name is historical). Healthcare fills specialty/payers; others business_type.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "specialty": {
          "default": "",
          "title": "Specialty",
          "type": "string"
        },
        "business_type": {
          "default": "",
          "title": "Business Type",
          "type": "string"
        },
        "customers": {
          "default": "",
          "title": "Customers",
          "type": "string"
        },
        "services": {
          "items": {
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        },
        "payers_accepted": {
          "items": {
            "type": "string"
          },
          "title": "Payers Accepted",
          "type": "array"
        },
        "patient_mix": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Patient Mix",
          "type": "object"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "existing_offices": {
          "items": {
            "$ref": "#/$defs/Office"
          },
          "title": "Existing Offices",
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "free_text": {
          "default": "",
          "title": "Free Text",
          "type": "string"
        },
        "stock_pack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stock Pack"
        },
        "region_id": {
          "default": "hou",
          "title": "Region Id",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "PracticeProfile",
      "type": "object"
    },
    "ScoringSpec": {
      "properties": {
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weights",
          "type": "object"
        },
        "directions": {
          "additionalProperties": {
            "enum": [
              1,
              -1
            ],
            "type": "integer"
          },
          "title": "Directions",
          "type": "object"
        },
        "beta": {
          "default": 2.0,
          "title": "Beta",
          "type": "number"
        },
        "alpha": {
          "default": 0.7,
          "title": "Alpha",
          "type": "number"
        },
        "rationale": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "object"
        }
      },
      "required": [
        "weights"
      ],
      "title": "ScoringSpec",
      "type": "object"
    }
  },
  "properties": {
    "region_id": {
      "default": "hou",
      "title": "Region Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/PracticeProfile"
    },
    "spec": {
      "$ref": "#/$defs/ScoringSpec"
    },
    "top_n": {
      "default": 15,
      "title": "Top N",
      "type": "integer"
    },
    "demand": {
      "anyOf": [
        {
          "$ref": "#/$defs/DemandModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "profile",
    "spec"
  ],
  "title": "ScoreRequest",
  "type": "object"
}