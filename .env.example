# Copy to .env and fill in. Never commit .env. Keep comments on their own lines.

# LLM: Amazon Nova on Amazon Bedrock (team AWS credits). AWS credentials come from the default credential chain
# (~/.aws profile locally, the EC2 instance role in production). Never put AWS keys in this file.
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
# Strongest Nova model the account can call (scripts/check_bedrock.py finds it)
MODEL_SMART=us.amazon.nova-pro-v1:0
MODEL_FAST=us.amazon.nova-2-lite-v1:0
# Optional per-role overrides: MODEL_<ROLE> / LLM_PROVIDER_<ROLE>, ROLE = ORCHESTRATOR, FACTOR_ANALYST,
# DATASET_SCOUT, SITE_SCOUT, CRITIC, JUDGE
LLM_MAX_CALLS_PER_RUN=40
LLM_CACHE=1
LLM_RPS=2
LLM_MAX_RETRIES=6
LLM_MAX_TOKENS=4096

# Dev-only fallbacks (LLM_PROVIDER=gemini or openrouter; set MODEL_SMART / MODEL_FAST to that provider's ids)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Agent wiring: AGENT_BACKEND = mock (fixtures) | local (data/raw files) | http (geo-service, sites-service)
# AGENT_MODE = planned (deepagents planning) | scripted (fixed step order; model reasons only)
AGENT_BACKEND=mock
AGENT_MODE=planned

# LangSmith tracing (for LangChain judges)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=siteline

# Census Data API (free key)
CENSUS_API_KEY=

# Optional web search for dataset-scouts if Nova web grounding is unavailable
TAVILY_API_KEY=

# CoStar track: use the exact names and values from the CoStar instructions
COSTAR_MCP_URL=
COSTAR_API_KEY=

# 1 = serve fixtures, 0 = real data
FIXTURE_MODE=1
REGION_ID=hou

# Local service URLs (docker-compose overrides these with service names)
AGENT_URL=http://localhost:8000
GEO_URL=http://localhost:8001
SITES_URL=http://localhost:8002
VITE_AGENT_URL=http://localhost:8000
VITE_FIXTURE_MODE=1

# 0 = wait for the human; 3 = demo mode auto-approves after 3 seconds
DEMO_AUTO_APPROVE_SECONDS=0
